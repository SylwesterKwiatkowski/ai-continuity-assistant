# Copy to `.env` and fill in local values. Never commit `.env`.

# Environment: local | dev | prod
APP_ENV=local

# Storage — SQLite path in MVP; a Postgres URL later.
DATABASE_URL=sqlite:///./assistant.sqlite

# Encryption key for the per-user token store. MUST be a real secret in prod.
TOKEN_STORE_KEY=dev-only-not-secret

# Summarizer (LLM). Unused while the deterministic stub is active.
LLM_API_KEY=
LLM_MODEL=claude-opus-4-8
