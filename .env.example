# Copy to `.env` and fill in local values. Never commit `.env`.

# Environment: local | dev | prod
APP_ENV=local

# Storage — SQLite path in MVP; a Postgres URL later.
DATABASE_URL=sqlite:///./assistant.sqlite

# Encryption key for the per-user token store. MUST be a real secret in prod.
TOKEN_STORE_KEY=dev-only-not-secret

# Auth mode: "dev" enables the demo user picker; "oauth" requires Google sign-in.
# "dev" is for local development only and is rejected outright when APP_ENV=prod.
# Scheduled for retirement in v0.2.1 — see docs/DELIVERY_PLAN.md, branch 4.
# SESSION_SECRET must be a real secret in prod (e.g. openssl rand -hex 32).
AUTH_MODE=dev
SESSION_SECRET=dev-only-session-secret
SESSION_TTL_HOURS=8

# Google OAuth (v0.2 login provider — implemented, D19 — plus v0.3 real connectors).
# How to obtain: docs/GOOGLE_OAUTH_SETUP.md. Read by Settings; the provider is wired up only
# when both id and secret are set, so leaving these blank locally is fine and expected.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Summarizer (LLM). Unused while the deterministic stub is active.
LLM_API_KEY=
LLM_MODEL=claude-opus-4-8
